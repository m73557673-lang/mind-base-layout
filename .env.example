# DocMind AI environment variables
# Copy this file to `.env` and fill in the values.

# Public app metadata (exposed to the client via import.meta.env.VITE_*)
VITE_APP_NAME="DocMind AI"
VITE_APP_URL="http://localhost:8080"

# Backend / AI provider keys (server-only — never prefixed with VITE_)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
